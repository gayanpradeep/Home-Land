# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.
#
# No quotes around values here: this file is loaded both by dotenv (scripts,
# Next.js) and by Docker Compose's `env_file`, which does NOT strip quote
# characters — a quoted value becomes part of the literal string in containers.

# PostgreSQL connection. In docker-compose, "postgres" is the service hostname;
# the user/password/db below must match the postgres service's own env vars.
# Published on host port 5433 (not 5432) to avoid clashing with a locally
# installed Postgres service, if you have one.
DATABASE_URL=postgresql://homeland:changeme@localhost:5433/homeland
POSTGRES_USER=homeland
POSTGRES_PASSWORD=changeme
POSTGRES_DB=homeland

# Session / auth
SESSION_COOKIE_NAME=hl_session
SESSION_TTL_HOURS=12
DEVICE_COOKIE_NAME=hl_device

# App
NODE_ENV=development
TZ=Asia/Colombo

# Initial Admin bootstrap (used only by scripts/create-initial-admin.ts).
# Spec dev defaults are admin / admin123 if left unset — never use those in production.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# DEV-ONLY UI preview without a database connection. Never set DEV_BYPASS_AUTH=true
# in production — it is hard-blocked there regardless, but keep it out of real envs.
DEV_BYPASS_AUTH=false
